               lsb-release,
               tcsh,
	       build-essential,
	       pkg-config,
               bison,
               flex,
               gawk,
               libedit-dev,
	       libstdc++6,
	       libboost-all-dev,
	       libbz2-dev,
	       libxml2-dev,
	       libxpm-dev,
	       libmotif-common,
	       libmotif-dev,
	       libxm4,
	       texlive-latex-recommended,
	       texlive-latex-extra,
	       texlive-fonts-recommended,
	       texlive-plain-generic,
	       texlive-pictures,
	       imagemagick,
	       graphviz,
	       fig2dev,
